# ── Required ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Real PostgreSQL (see docs/SETUP.md). For the embedded dev DB use:
#   DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5499/postgres  and DB_POOL_MAX=1
DATABASE_URL=postgres://gpms_app:CHANGE_ME@localhost:5432/gpms
DB_POOL_MAX=10
# Long random string in production:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ── Web ─────────────────────────────────────────────────────
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── First Super Admin (used by `npm run seed`) ──────────────
ADMIN_EMAIL=admin@gpms.local
# Leave empty to auto-generate and print a password once
ADMIN_PASSWORD=

# ── Uploads ─────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ── Email (optional; without it emails are logged in development) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GPMS <no-reply@example.com>
